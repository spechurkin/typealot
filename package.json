{
  "name": "typealot",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/install/patch-xyflow.mjs && node scripts/install/patch-capacitor-gradle.mjs && node scripts/install/patch-electron-deps.mjs && node scripts/install/patch-y-tiptap.mjs",
    "capacitor:sync:after": "node scripts/install/patch-capacitor-gradle.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:i18n": "vitest run tests/locales/i18n.test.ts tests/locales/native-i18n.test.ts",
    "test:ui": "playwright test",
    "desktop": "npm run build && electron .",
    "android:sync": "npm run build && cap sync android",
    "android:add": "cap add android",
    "android:prepare": "npm run android:sync && node scripts/android/prepare-android.mjs",
    "android:assets": "npm run build && cap copy android",
    "android:studio": "npm run android:prepare && cap open android",
    "sync:server": "node server/sync-server.mjs",
    "release:desktop": "npm run build && node scripts/desktop/desktop-release.cjs",
    "release:server": "npm run build && node scripts/release/server-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@floating-ui/dom": "^1.8.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-bubble-menu": "^3.32.3",
    "@tiptap/extension-collaboration": "^3.32.3",
    "@tiptap/extension-collaboration-caret": "^3.32.3",
    "@tiptap/extension-highlight": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-placeholder": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-task-item": "^3.32.3",
    "@tiptap/extension-task-list": "^3.32.3",
    "@tiptap/extension-text-align": "^3.32.3",
    "@tiptap/extension-text-style": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@tiptap/suggestion": "^3.32.3",
    "@tiptap/y-tiptap": "3.1.0",
    "@xyflow/react": "12.12.1",
    "electron-updater": "6.8.11",
    "idb-keyval": "^6.3.0",
    "lib0": "^0.2.119",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.22.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "serverVersion": "1.0.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4",
    "@electron/asar": "4.3.1",
    "@electron/get": "5.1.0",
    "lodash.isequal": "npm:lodash@^4.18.1",
    "glob": "^14.0.3",
    "temp": {
      "rimraf": "^6.1.4"
    }
  }
}
