{
  "name": "typealot",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:i18n": "vitest run tests/i18n.test.ts tests/native-i18n.test.ts",
    "test:ui": "playwright test",
    "desktop": "npm run build && electron .",
    "android:sync": "npm run build && cap sync android",
    "android:add": "cap add android",
    "android:prepare": "npm run android:sync && node scripts/prepare-android.mjs",
    "android:assets": "npm run build && cap copy android",
    "android:studio": "npm run android:prepare && cap open android",
    "sync:server": "node scripts/sync-server.mjs",
    "release:desktop": "npm run build && node scripts/desktop-release.cjs",
    "release:server": "npm run build && node scripts/server-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@floating-ui/dom": "^1.7.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bubble-menu": "^3.0.0",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-collaboration-caret": "^3.32.2",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/suggestion": "^3.0.0",
    "@tiptap/y-tiptap": "^3.0.12",
    "@xyflow/react": "^12.0.0",
    "electron-updater": "^6.8.11",
    "idb-keyval": "^6.2.0",
    "lib0": "^0.2.119",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "serverVersion": "1.0.1"
}
